{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build warehouse",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
                "-std=c++20",
                "-g",
                "main.cpp",
                "app.rc",
                "-o",
                "main.exe",
                "-mwindows",
                "-LC:/msys64/ucrt64/lib",
                "-lpqxx",
                "-lpq",
                "-lgdi32",
                "-luser32",
                "-lcomctl32",
                "-lws2_32",
                "-lwinspool"
            ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
        "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
               }
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}