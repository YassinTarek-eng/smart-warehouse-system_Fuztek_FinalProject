{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Smart Warehouse",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/main.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [
        { "name": "PATH", "value": "C:/msys64/ucrt64/bin;${env:PATH}" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "build warehouse",
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}